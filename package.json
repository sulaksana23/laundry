{
  "name": "laundry-management-nextjs",
  "version": "0.17.0",
  "private": true,
  "description": "Sistem operasional laundry berbasis Next.js dengan pola UI TypeUI yang ringkas.",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed:demo": "node scripts/seed-demo.mjs",
    "vercel-build": "npm run db:migrate && npm run db:seed:demo && npm run build"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.65.0",
    "next": "^16.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.5",
    "@neondatabase/serverless": "^1.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.34.0",
    "eslint-config-next": "^16.4.3",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2"
  },
  "license": "MIT",
  "author": "Bali Tech Solution"
}
