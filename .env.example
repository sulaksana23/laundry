# PostgreSQL Neon (gunakan hanya pada environment yang telah dibatasi aksesnya).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
LAUNDRY_BRANCH_ID="main"
# Aktifkan untuk menguji PostgreSQL secara lokal. Vercel Preview aktif bila DATABASE_URL tersedia.
LAUNDRY_DATABASE_MODE="true"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Rahasia sesi autentikasi, minimal 32 karakter acak. Jangan commit nilai asli.
AUTH_SECRET=""

# Backup otomatis produksi memerlukan Vercel private Blob dan rahasia Cron.
# Hubungkan Blob store melalui proyek Vercel; jangan commit token asli.
BLOB_READ_WRITE_TOKEN=""
CRON_SECRET=""
